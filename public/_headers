/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https://lh3.googleusercontent.com https://yt3.ggpht.com https://*.googleapis.com https://*.gstatic.com; font-src 'self'; connect-src 'self' https://maps.googleapis.com; frame-src 'self' https:; worker-src 'self'; manifest-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/probe/*
  Cache-Control: no-store

/dev/*
  Cache-Control: no-store
